{
  "name": "@campuspulse/web",
  "version": "0.1.0",
  "private": true,
  "description": "CampusPulse web — attendee feed, organizer portal and super admin.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "codegen": "openapi-typescript ../campuspulse-backend/openapi.json -o src/lib/api-schema.d.ts",
    "codegen:remote": "openapi-typescript https://raw.githubusercontent.com/CampusPulse-dev/campuspulse-backend/main/openapi.json -o src/lib/api-schema.d.ts",
    "codegen:check": "npm run codegen:remote && git diff --exit-code src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
