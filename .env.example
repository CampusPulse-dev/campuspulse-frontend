# Base URL of campuspulse-backend. No trailing slash.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# Explicit fixture mode. Default false; build with true for the frontend demo.
NEXT_PUBLIC_DEMO_MODE="false"
# TODO(S1-02): remove once real JWT auth lands; sends X-Dev-User header in live dev mode.
NEXT_PUBLIC_DEV_AUTH="false"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_SITE_URL="https://campuspulse.ng"
# Comma-separated hosts whose event cover images are optimized by next/image
# (e.g. "media.campuspulse.ng"). Covers on other hosts are served as-is.
NEXT_PUBLIC_MEDIA_HOSTS=""
